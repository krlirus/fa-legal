{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "agreementType": {
            "type": "enum",
            "options": [
                "Monto fijo",
                "Por etapas",
                "Por hora",
                "Porcentaje",
                "Cuota litis",
                "UMA",
                "Mixto",
                "Otro"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "currencyCode": {
            "type": "enum",
            "options": [
                "ARS",
                "USD",
                "UMA"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "amount": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "percentage": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "umaAmount": {
            "notNull": false,
            "type": "float",
            "isCustom": true
        },
        "feeStatus": {
            "type": "enum",
            "options": [
                "Sin cotizar",
                "Presupuesto enviado",
                "Aceptado",
                "Pago parcial",
                "Pagado",
                "Vencido"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "agreementDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "dueDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "matter": {
            "type": "link"
        },
        "client": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "matter": {
            "type": "belongsTo",
            "foreign": "fees",
            "entity": "CAsunto",
            "audited": true,
            "isCustom": true
        },
        "client": {
            "type": "belongsTo",
            "foreign": "fees",
            "entity": "CCliente",
            "audited": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}