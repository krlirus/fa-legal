{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "internalCode": {
            "type": "varchar",
            "maxLength": 60,
            "isCustom": true
        },
        "practiceArea": {
            "type": "enum",
            "options": [
                "Civil",
                "Comercial",
                "Laboral",
                "ART",
                "Penal",
                "Penal Económico",
                "Familia",
                "Sucesiones",
                "Administrativo",
                "Tributario",
                "Consumidor",
                "Societario",
                "Contratos",
                "Real Estate",
                "Daños",
                "Tránsito",
                "Salud",
                "Discapacidad",
                "Investigación patrimonial",
                "Due Diligence",
                "Otros"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "matterStatus": {
            "type": "enum",
            "options": [
                "Consulta",
                "Evaluación",
                "Presupuesto enviado",
                "Pendiente aceptación",
                "Activo",
                "En negociación",
                "Judicializado",
                "Pendiente de resolución",
                "En ejecución",
                "Suspendido",
                "Finalizado",
                "Archivado"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "priority": {
            "type": "enum",
            "options": [
                "Baja",
                "Normal",
                "Alta",
                "Urgente"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "openingDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "strategy": {
            "type": "text",
            "isCustom": true,
            "audited": true
        },
        "nextAction": {
            "type": "text",
            "isCustom": true
        },
        "nextActionDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "counterparty": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "feeStatus": {
            "type": "enum",
            "options": [
                "Sin cotizar",
                "Presupuesto enviado",
                "Aceptado",
                "Pago parcial",
                "Pagado",
                "Vencido"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "driveFolderUrl": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "client": {
            "type": "link"
        },
        "strategyStatus": {
            "type": "enum",
            "options": [
                "Sin definir",
                "En análisis",
                "Definida",
                "En ejecución",
                "A revisar",
                "Cerrada"
            ],
            "maxLength": 100,
            "audited": true,
            "isCustom": true
        },
        "legalObjective": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "strengths": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "weaknesses": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "risks": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "proceduralLine": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "legalNotes": {
            "type": "text",
            "audited": true,
            "isCustom": true
        },
        "strategyReviewDate": {
            "type": "date",
            "notNull": false,
            "audited": true,
            "isCustom": true
        },
        "strategyOwner": {
            "type": "link",
            "audited": true,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "client": {
            "type": "belongsTo",
            "foreign": "matters",
            "entity": "CCliente",
            "audited": true,
            "isCustom": true
        },
        "dockets": {
            "type": "hasMany",
            "foreign": "matter",
            "entity": "CExpediente",
            "audited": true,
            "isCustom": true
        },
        "deadlines": {
            "type": "hasMany",
            "foreign": "matter",
            "entity": "CVencimiento",
            "audited": true,
            "isCustom": true
        },
        "hearings": {
            "type": "hasMany",
            "foreign": "matter",
            "entity": "CAudiencia",
            "audited": true,
            "isCustom": true
        },
        "fees": {
            "type": "hasMany",
            "foreign": "matter",
            "entity": "CHonorario",
            "audited": true,
            "isCustom": true
        },
        "strategyOwner": {
            "type": "belongsTo",
            "entity": "User",
            "audited": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name"
        ],
        "fullTextSearch": false,
        "countDisabled": false
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    },
    "optimisticConcurrencyControl": false,
    "transactionalSave": false
}