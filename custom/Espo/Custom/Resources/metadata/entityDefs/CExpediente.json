{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "docketNumber": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "jurisdiction": {
            "type": "enum",
            "options": [
                "Nacional",
                "Federal",
                "CABA",
                "Provincial",
                "Administrativa",
                "Arbitral",
                "Otra"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "province": {
            "type": "enum",
            "options": [
                "CABA",
                "Buenos Aires",
                "Neuquén",
                "Río Negro",
                "Córdoba",
                "Santa Fe",
                "Mendoza",
                "Otra"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "courtArea": {
            "type": "enum",
            "options": [
                "Civil",
                "Comercial",
                "Laboral",
                "Penal",
                "Penal Económico",
                "Familia",
                "Contencioso Administrativo",
                "Federal",
                "Otro"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "court": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "clerkOffice": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "prosecutorOffice": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "instance": {
            "type": "enum",
            "options": [
                "Primera instancia",
                "Cámara",
                "Casación",
                "Superior Tribunal",
                "Corte Suprema",
                "Otra"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "proceedingType": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "startDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "proceduralStatus": {
            "type": "enum",
            "options": [
                "Inicio",
                "En trámite",
                "Prueba",
                "Alegatos",
                "Para resolver",
                "Sentencia",
                "Apelación",
                "Ejecución",
                "Suspendido",
                "Finalizado",
                "Archivado"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "plaintiff": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "defendant": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "accused": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "complainant": {
            "type": "varchar",
            "maxLength": 190,
            "isCustom": true
        },
        "courtUrl": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "lastDocketDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "nextDocketAction": {
            "type": "text",
            "isCustom": true
        },
        "nextDocketDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "matter": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "matter": {
            "type": "belongsTo",
            "foreign": "dockets",
            "entity": "CAsunto",
            "audited": true,
            "isCustom": true
        },
        "docketActions": {
            "type": "hasMany",
            "foreign": "docket",
            "entity": "CActuacion",
            "audited": true,
            "isCustom": true
        },
        "deadlines": {
            "type": "hasMany",
            "foreign": "docket",
            "entity": "CVencimiento",
            "audited": true,
            "isCustom": true
        },
        "hearings": {
            "type": "hasMany",
            "foreign": "docket",
            "entity": "CAudiencia",
            "audited": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}