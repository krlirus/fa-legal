{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "clientType": {
            "type": "enum",
            "options": [
                "Persona humana",
                "Persona jurídica"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "dni": {
            "type": "varchar",
            "maxLength": 30,
            "isCustom": true
        },
        "taxId": {
            "type": "varchar",
            "maxLength": 30,
            "isCustom": true
        },
        "birthDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "phoneNumberText": {
            "type": "varchar",
            "maxLength": 80,
            "isCustom": true
        },
        "whatsapp": {
            "type": "varchar",
            "maxLength": 80,
            "isCustom": true
        },
        "emailAddressText": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true
        },
        "addressText": {
            "type": "text",
            "isCustom": true
        },
        "clientStatus": {
            "type": "enum",
            "options": [
                "Potencial",
                "Activo",
                "Inactivo",
                "Histórico",
                "No aceptar"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "intakeDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "referredBy": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true
        },
        "driveFolderUrl": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "matters": {
            "type": "hasMany",
            "foreign": "client",
            "entity": "CAsunto",
            "audited": true,
            "isCustom": true
        },
        "fees": {
            "type": "hasMany",
            "foreign": "client",
            "entity": "CHonorario",
            "audited": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}