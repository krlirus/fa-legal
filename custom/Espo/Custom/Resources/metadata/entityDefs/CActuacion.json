{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "actionDate": {
            "notNull": false,
            "type": "datetime",
            "isCustom": true
        },
        "actionType": {
            "type": "enum",
            "options": [
                "Escrito presentado",
                "Resolución",
                "Providencia",
                "Cédula / Notificación",
                "Audiencia",
                "Llamada",
                "Reunión",
                "Gestión administrativa",
                "Informe",
                "Otro"
            ],
            "maxLength": 100,
            "isCustom": true
        },
        "nextAction": {
            "type": "text",
            "isCustom": true
        },
        "nextActionDate": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "generatedDeadline": {
            "notNull": false,
            "type": "date",
            "isCustom": true
        },
        "docket": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "docket": {
            "type": "belongsTo",
            "foreign": "docketActions",
            "entity": "CExpediente",
            "audited": true,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}